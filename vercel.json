{
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.lavadotinacos.com"
        }
      ],
      "destination": "https://lavadotinacos.com/:path*",
      "permanent": true
    },
    {
      "source": "/queretaro",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ciudades/queretaro",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ciudades/:city(cdmx|edomex|guadalajara|monterrey|puebla|toluca|cuernavaca|leon|merida|san-luis-potosi|aguascalientes|cancun)",
      "destination": "/:city",
      "permanent": true
    },
    {
      "source": "/hacia-donde-se-cierra-una-llave-de-agua",
      "destination": "/blog/hacia-que-lado-cierra-una-llave-de-agua",
      "permanent": true
    },
    {
      "source": "/cual-es-la-llave-de-paso-del-tinaco",
      "destination": "/blog/hacia-que-lado-cierra-una-llave-de-agua",
      "permanent": true
    },
    {
      "source": "/dispositivos-anti-sarro-para-tinacos-y-cisternas-cual-comprar",
      "destination": "/blog/dispositivo-antisarro-tipo-ionizador-funciona",
      "permanent": true
    },
    {
      "source": "/falta-de-presion-de-agua-en-casa",
      "destination": "/blog/por-que-no-sube-agua-al-tinaco",
      "permanent": true
    },
    {
      "source": "/:slug(como-saber-si-tengo-una-fuga-de-agua-en-mi-casa|cpvc-tuboplus-o-cobre-cual-es-la-mejor-tuberia|dispositivo-antisarro-tipo-ionizador-funciona|enfermedades-derivadas-de-un-tinaco-sucio|hacia-donde-cierra-una-llave-de-agua-que-no-deja-de-girar|por-que-no-sube-agua-al-tinaco|tinaco-o-cisterna-cual-me-conviene-mas-y-por-que|por-que-no-sale-agua-de-la-regadera-si-el-tinaco-esta-lleno)",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/dispositivo-antisarro-tipo-ablandador-funciona",
      "destination": "/blog/dispositivo-antisarro-tipo-ionizador-funciona",
      "permanent": true
    },
    {
      "source": "/tu-tinaco-se-quedo-sin-tapa",
      "destination": "/blog/no-todas-las-tapas-para-tinaco-son-iguales",
      "permanent": true
    },
    {
      "source": "/:old(costo-de-lavar-un-tinaco-en-mexico-2023|lavado-de-tinaco-precio)",
      "destination": "/blog/cuanto-cuesta-lavar-un-tinaco-de-hasta-1100-litros-en-mexico-en-2026-precios-por-zona",
      "permanent": true
    },
    {
      "source": "/:old(como-lavar-tu-tinaco-tu-mismo|hablemos-de-como-lavar-mi-tinaco-sin-vaciarlo-y-por-que-no-hacerlo)",
      "destination": "/blog/errores-al-lavar-el-tinaco-por-cuenta-propia",
      "permanent": true
    },
    {
      "source": "/:old(lista-de-enfermedades-por-uso-de-agua-potable-contaminada|tu-tinaco-sucio-podria-matarte-esta-es-la-razon)",
      "destination": "/blog/enfermedades-derivadas-de-un-tinaco-sucio",
      "permanent": true
    },
    {
      "source": "/por-que-lavar-tu-tinaco-de-forma-regular",
      "destination": "/blog/cada-cuanto-tiempo-lavar-tinaco-y-cisterna-cofepris",
      "permanent": true
    },
    {
      "source": "/:old(si-usas-un-purificador-de-agua-en-casa-puedes-correr-peligro|author/lavadotinacos|category/blog-lavado-de-tinacos)",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/tag/:path*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/:old(contactanos|nuestro-proceso|zonas-de-servicio-monsterco-queretaro|galeria-lavado-de-tinacos-monsterco|probono|probono-casos-de-ayuda)",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/admin/settings",
      "destination": "/api/settings"
    },
    {
      "source": "/api/admin/author",
      "destination": "/api/author"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/page?slug=:slug"
    },
    {
      "source": "/:city(cdmx|edomex|guadalajara|monterrey|puebla|toluca|cuernavaca|leon|merida|san-luis-potosi|aguascalientes|cancun)",
      "destination": "/api/page?city=:city"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/terminos",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/page"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
