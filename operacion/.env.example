# Copia este archivo como .env y llena lo que haga falta. El .env no se sube al repositorio.

# Clave para entrar a administración. Obligatoria en producción.
ADMIN_PASSWORD=

# Postgres de producción. Sin esta variable se usa un Postgres local guardado en la carpeta .datos
DATABASE_URL=

# Dirección pública de la plataforma, para los enlaces que van en los avisos.
URL_PUBLICA=http://localhost:5173

# Puerto del servidor en desarrollo (el panel de Vite le reenvía /api). En producción se usa PORT.
PUERTO_API=3100

# Opcionales
ANTICIPACION_MINUTOS=90
MINUTOS_SIN_PROVEEDOR=30

# WhatsApp por la API de Meta. Con WHATSAPP_TOKEN y WHATSAPP_PHONE_ID los avisos salen solos;
# sin ellos se mandan a mano desde el panel.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Para el webhook (entregas y respuestas): secreto de la app de Meta y una frase que tú inventas.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Sólo para registrar las plantillas con `npm run plantillas -- --registrar`.
WHATSAPP_WABA_ID=
# WhatsApp de 10 dígitos donde la casa recibe sus avisos (opcional).
ADMIN_WHATSAPP=
